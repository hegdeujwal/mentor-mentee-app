# SQLite for local development. For PostgreSQL, change the provider in
# prisma/schema.prisma to "postgresql" and use a postgres:// URL here.
DATABASE_URL="file:./dev.db"

# Secret used by Auth.js to sign and encrypt session tokens.
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"

# Required when running behind a proxy or with `next start` locally.
AUTH_TRUST_HOST=true

# Whether the HOD may read mentors' PRIVATE notes (true/false).
HOD_CAN_VIEW_PRIVATE_NOTES=true

# Production only (e.g. Vercel). When set, the app uses this hosted Turso (libSQL)
# database instead of the SQLite file above. Leave unset for local development.
# Apply migrations with:  node scripts/turso-migrate.mjs
# TURSO_DATABASE_URL="libsql://<database>-<org>.turso.io"
# TURSO_AUTH_TOKEN="..."
